APP_NAME="NusaPOS Retail"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.tokoanda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database MySQL 8 / MariaDB 10.6+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nusapos_retail
DB_USERNAME=nusapos_user
DB_PASSWORD=GANTI_PASSWORD_KUAT

# Session & Keamanan HTTPS
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# QZ Tray Digital Signing (simpan di luar folder public!)
QZ_PRIVATE_KEY_PATH=/var/www/pos/storage/app/private/qz/private-key.pem
QZ_CERTIFICATE_PATH=/var/www/pos/storage/app/private/qz/digital-certificate.txt
QZ_SIGNATURE_ALGORITHM=sha512

# Retensi Backup Database Otomatis (hari)
POS_BACKUP_RETENTION_DAYS=14
